# Xiaohongshu Quantumult X rewrite-only publish/comment IP routing
# v2.4.0 - 2026-10-11
#
# This intentionally matches ALL edith.xiaohongshu.com URLs.
# script-analyze-echo-response is body-related; Quantumult X skips it when
# the request body is empty. Therefore body-bearing API writes (and any
# body-bearing API calls) are replayed through 📤 小红书上传.
#
# Goal:
# - publish note -> selected policy IP
# - post/reply comment -> selected policy IP
# - avoid relying on unstable private App endpoint paths

hostname = edith.xiaohongshu.com
^https:\/\/edith\.xiaohongshu\.com\/.* url script-analyze-echo-response https://raw.githubusercontent.com/colorfullife123/xiaohongshu-qx-routing/qx-precise-routing-v2/scripts/xhs-write-ip.js#policy=%F0%9F%93%A4%20%E5%B0%8F%E7%BA%A2%E4%B9%A6%E4%B8%8A%E4%BC%A0
