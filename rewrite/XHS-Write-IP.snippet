# Xiaohongshu Quantumult X smart publish/comment routing
# v2.4.1 - 2026-10-11
#
# Broad hook on edith.xiaohongshu.com, but the script classifies requests:
# - publish/comment write actions -> 📤 小红书上传
# - comment page/list/query/detail and other read/browse requests -> DIRECT
# - unknown body-bearing requests -> DIRECT

hostname = edith.xiaohongshu.com
^https:\/\/edith\.xiaohongshu\.com\/.* url script-analyze-echo-response https://raw.githubusercontent.com/colorfullife123/xiaohongshu-qx-routing/qx-precise-routing-v2/scripts/xhs-write-ip-v2.4.1.js#policy=%F0%9F%93%A4%20%E5%B0%8F%E7%BA%A2%E4%B9%A6%E4%B8%8A%E4%BC%A0
