# Xiaohongshu Quantumult X precise write-action routing v2.2.0
# TEST BRANCH: qx-precise-routing-v2
# Requires Quantumult X MITM for edith.xiaohongshu.com.
#
# Proxy ONLY write actions through "📤 小红书上传":
# - upload permit
# - final note publish
# - comment post/reply/create
#
# Comment list/page/detail and other normal edith APIs are NOT matched and remain DIRECT.

hostname = edith.xiaohongshu.com
^https:\/\/edith\.xiaohongshu\.com\/api\/media\/v1\/upload\/capa\/permit(?:\?.*)?$ url script-analyze-echo-response https://raw.githubusercontent.com/colorfullife123/xiaohongshu-qx-routing/qx-precise-routing-v2/scripts/xhs-publish-route.js#policy=%F0%9F%93%A4%20%E5%B0%8F%E7%BA%A2%E4%B9%A6%E4%B8%8A%E4%BC%A0
^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v2\/note(?:\?.*)?$ url script-analyze-echo-response https://raw.githubusercontent.com/colorfullife123/xiaohongshu-qx-routing/qx-precise-routing-v2/scripts/xhs-publish-route.js#policy=%F0%9F%93%A4%20%E5%B0%8F%E7%BA%A2%E4%B9%A6%E4%B8%8A%E4%BC%A0

# Confirmed Web comment post/reply endpoint.
^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/web\/v1\/comment\/post(?:\?.*)?$ url script-analyze-echo-response https://raw.githubusercontent.com/colorfullife123/xiaohongshu-qx-routing/qx-precise-routing-v2/scripts/xhs-publish-route.js#policy=%F0%9F%93%A4%20%E5%B0%8F%E7%BA%A2%E4%B9%A6%E4%B8%8A%E4%BC%A0

# App-version compatible write-only comment endpoints.
# These intentionally do NOT match list/page/query/read endpoints.
^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/(?:web\/)?v[0-9]+\/comment\/(?:post|create|reply|send)(?:\?.*)?$ url script-analyze-echo-response https://raw.githubusercontent.com/colorfullife123/xiaohongshu-qx-routing/qx-precise-routing-v2/scripts/xhs-publish-route.js#policy=%F0%9F%93%A4%20%E5%B0%8F%E7%BA%A2%E4%B9%A6%E4%B8%8A%E4%BC%A0
^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v[0-9]+\/note\/comment\/(?:post|create|reply|send)(?:\?.*)?$ url script-analyze-echo-response https://raw.githubusercontent.com/colorfullife123/xiaohongshu-qx-routing/qx-precise-routing-v2/scripts/xhs-publish-route.js#policy=%F0%9F%93%A4%20%E5%B0%8F%E7%BA%A2%E4%B9%A6%E4%B8%8A%E4%BC%A0
