# Xiaohongshu Quantumult X precise publish routing v2.1.0
# TEST BRANCH: qx-precise-routing-v2
# Requires Quantumult X MITM for edith.xiaohongshu.com.
# Only upload permit + final note creation are replayed through the selected policy.
# Comments/detail/normal edith APIs are NOT matched and remain on normal filter rules.

hostname = edith.xiaohongshu.com
^https:\/\/edith\.xiaohongshu\.com\/api\/media\/v1\/upload\/capa\/permit(?:\?.*)?$ url script-analyze-echo-response https://raw.githubusercontent.com/colorfullife123/xiaohongshu-qx-routing/qx-precise-routing-v2/scripts/xhs-publish-route.js#policy=%F0%9F%93%A4%20%E5%B0%8F%E7%BA%A2%E4%B9%A6%E4%B8%8A%E4%BC%A0
^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v2\/note(?:\?.*)?$ url script-analyze-echo-response https://raw.githubusercontent.com/colorfullife123/xiaohongshu-qx-routing/qx-precise-routing-v2/scripts/xhs-publish-route.js#policy=%F0%9F%93%A4%20%E5%B0%8F%E7%BA%A2%E4%B9%A6%E4%B8%8A%E4%BC%A0
